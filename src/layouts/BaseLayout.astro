---
import '../styles/global.css';
import geistWoff2 from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMonoWoff2 from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  jsonLd?: object;
  noindex?: boolean;
}

const { title, description, image, imageAlt, jsonLd, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={geistWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <SEO {title} {description} {image} {imageAlt} {jsonLd} {noindex} />
    <script is:inline>
      (function () {
        try {
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          var root = document.documentElement, store = sessionStorage;
          var arrive = store.getItem('px-arrive');
          store.removeItem('px-arrive');
          var intro = location.pathname === '/' && !store.getItem('px-intro');
          store.setItem('px-intro', '1');
          if (!arrive && !intro) return;
          root.dataset.cover = arrive ? 'arrive' : 'intro';
          root.classList.add('px-covered');
          setTimeout(function () { root.classList.remove('px-covered'); }, 2500);
        } catch (e) {}
      })();
    </script>
    {
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon='{"token": "128cd33629874c88a80baa86f02aa829"}'
        />
      )
    }
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/page-cover-init';
      import '../scripts/pixel-button';
      import '../scripts/canvas-effects';
      import '../scripts/smooth-scroll';
    </script>
  </body>
</html>
