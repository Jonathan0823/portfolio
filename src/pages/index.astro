---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import Projects from '../components/Projects.astro';
import PageEnd from '../components/PageEnd.astro';
import { getSkills } from '../lib/content';
import { pageSeo, personJsonLd } from '../lib/seo';

const seo = pageSeo('home');
const skills = (await getSkills()).map((s) => s.data);
const jsonLd = personJsonLd(Astro.site!.href, skills);

const navLinks = [
  { href: '#experience', label: 'Experience', sec: 'experience' },
  { href: '#skills', label: 'Skills', sec: 'skills' },
  { href: '#projects', label: 'Projects', sec: 'projects' },
  { href: '/story', label: 'Story' },
  { href: '#contact', label: 'Contact', sec: 'contact' },
];
---

<BaseLayout title={seo.title} description={seo.description} image={seo.ogPath} imageAlt={seo.imageAlt} {jsonLd}>
  <Nav links={navLinks} />
  <main>
    <Hero />
    <Experience />
    <Skills />
    <Projects />
    <PageEnd headline="Let’s build something that holds up" />
  </main>
</BaseLayout>
