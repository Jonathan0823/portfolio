---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Eguin Jonathan" description="That page doesn’t exist, or it moved." noindex>
  <main class="flex min-h-svh flex-col justify-center px-5 md:px-24">
    <p class="text-muted font-mono text-[13px] leading-relaxed">404</p>
    <h1 class="mt-4 text-6xl leading-[0.92] font-semibold tracking-[-0.055em] text-balance md:text-[120px]">
      Nothing here<span class="text-accent">.</span>
    </h1>
    <p class="mt-8 max-w-[34ch] text-xl leading-[1.45] tracking-[-0.01em] md:text-[26px]">
      That page doesn’t exist, or it moved.
    </p>
    <p class="mt-6 font-mono text-[13px] leading-relaxed">
      <a href="/" class="text-ink hover:text-muted">
        ← Back to the home page
      </a>
    </p>
  </main>
</BaseLayout>
