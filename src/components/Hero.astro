---
import { CONTACT_EMAIL, GITHUB_URL, LINKEDIN_URL, MAILTO_URL } from '@/lib/profile';
import { heatIcons } from '@/lib/heat-icons';
import ButtonIcon from './ButtonIcon.astro';

// the footer's pill buttons a size down; stacked on phones and on touch
const pill =
  'btn-with-icon rounded-full border border-[#d4d4d4] px-[17px] py-[9px] text-sm leading-5 font-medium text-ink no-underline';
const icons = heatIcons(14);
---

<script is:inline>
  // the drip builds the headline's period from nothing, so hide it before the first paint. Without JS, or with
  // reduced motion (which skips the drip), it stays visible
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('drip-pending');
</script>

<!-- phones: the hero is as tall as its content, so the next section peeks in; md and up fill the screen -->
<section id="top" class="relative flex flex-col md:h-svh md:min-h-[800px]">
  <div data-pixel-field="hero" aria-hidden="true" class="h-[200px] w-full md:h-[336px]"></div>
  <canvas data-glyph aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-[5] hidden"></canvas>
  <div class="flex flex-col justify-end gap-6 px-5 pt-3 pb-6 md:flex-1 md:gap-7 md:px-24 md:pt-0 md:pb-[72px]">
    <p class="sr-only">Eguin Jonathan, Software Engineer</p>
    <h1
      data-glyph-text
      data-intro-rise
      class="text-[clamp(84px,27vw,112px)] leading-[0.9] font-semibold tracking-[-0.06em] md:text-[168px]"
    >
      Hi, I’m
      <br />
      Eguin
      <span class="text-accent" data-drip-period>
        .
      </span>
    </h1>
    <div data-glyph-text class="flex flex-col gap-1.5 md:gap-2.5">
      <p class="text-base leading-normal text-ink md:text-[17px]">
        <span class="block md:inline">Software Engineer</span>
        <span class="hidden md:inline"> · </span>
        <span class="block md:inline">Backend & Full-Stack</span>
        <br class="hidden md:inline" />
        <span class="block md:inline">Karawang, Indonesia (UTC+7)</span>
        <span class="hidden md:inline"> · </span>
        <span class="block md:inline">open to remote roles</span>
      </p>
      <p class="max-w-[68ch] text-base leading-relaxed text-muted">
        Highlight: cut a 300M-point dashboard from 5 min to under 10 s.{' '}
        <a href="#experience" class="text-ink underline decoration-[#d4d4d4] underline-offset-4 hover:decoration-ink">
          See how ↓
        </a>
      </p>
    </div>
    <div data-hero-links class="hero-links relative flex flex-col items-start gap-3.5 md:flex-row">
      <a
        href={MAILTO_URL}
        data-glyph-for="mail"
        data-pixel-btn="dark"
        class="btn-with-icon rounded-full bg-ink px-[18px] py-[10px] text-sm leading-5 font-medium text-paper no-underline"
        style={icons.mail.style}
      >
        <ButtonIcon icon={icons.mail} />
        {CONTACT_EMAIL}
      </a>
      <a href={GITHUB_URL} data-glyph-for="git" data-pixel-btn class={pill} style={icons.git.style}>
        <ButtonIcon icon={icons.git} />
        GitHub
      </a>
      <a href={LINKEDIN_URL} data-glyph-for="linkedin" data-pixel-btn class={pill} style={icons.linkedin.style}>
        <ButtonIcon icon={icons.linkedin} />
        LinkedIn
      </a>
    </div>
  </div>
</section>

<section class="px-5 pt-10 md:px-24 md:pt-40">
  <p class="text-[25px] leading-tight font-medium tracking-[-0.02em] text-pretty md:max-w-[min(83.333%,56ch)] md:text-5xl md:leading-[1.2] md:tracking-[-0.03em]">
    I’m a software engineer in Karawang, Indonesia. I write the software between factory machines and the people who
    watch them: device gateways, data pipelines and dashboards that load fast.
  </p>
</section>
