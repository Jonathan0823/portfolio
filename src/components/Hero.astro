---
import { CONTACT_EMAIL, GITHUB_URL, LINKEDIN_URL, MAILTO_URL } from '@/lib/profile';
---

<section id="top" class="relative flex h-svh min-h-[660px] flex-col md:min-h-[800px]">
  <div data-pixel-field="hero" aria-hidden="true" class="h-[300px] w-full md:h-[336px]"></div>
  <canvas data-glyph aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-[5] hidden"></canvas>
  <div class="flex flex-1 flex-col justify-end gap-6 px-5 pb-12 md:gap-7 md:px-24 md:pb-[72px]">
    <p class="sr-only">Eguin Jonathan, Software Engineer</p>
    <h1
      data-glyph-text
      data-intro-rise
      class="text-[84px] leading-[0.9] font-semibold tracking-[-0.06em] md:text-[168px]"
    >
      Hi, I’m
      <br />
      Eguin<span class="text-accent">.</span>
    </h1>
    <div data-glyph-text class="flex flex-col gap-1.5 md:gap-2.5">
      <p class="font-mono text-sm leading-normal text-ink md:text-[15px]">
        Software Engineer · Backend & Full-Stack · Karawang, Indonesia (UTC+7) · open to remote roles
      </p>
      <p class="font-mono text-[13px] leading-relaxed text-muted md:text-sm">
        Latest: cut a 300M-point dashboard from 5 min to under 10 s.
        <a href="#experience" class="text-ink">
          See how ↓
        </a>
      </p>
    </div>
    <p class="flex flex-col gap-2 font-mono text-sm leading-relaxed text-muted md:flex-row md:gap-0">
      <a href={MAILTO_URL} data-glyph-for="mail" class="text-ink">
        {CONTACT_EMAIL}
      </a>
      <span class="hidden md:inline">&nbsp;&nbsp;·&nbsp;&nbsp;</span>
      <span>
        <a href={GITHUB_URL} data-glyph-for="git" class="text-ink">
          GitHub
        </a>
      </span>
      <span class="hidden md:inline">&nbsp;&nbsp;·&nbsp;&nbsp;</span>
      <span>
        <a href={LINKEDIN_URL} data-glyph-for="linkedin" class="text-ink">
          LinkedIn
        </a>
      </span>
    </p>
  </div>
</section>

<section class="px-5 pt-24 md:px-24 md:pt-40">
  <p class="text-[28px] leading-tight font-medium tracking-[-0.02em] text-pretty md:max-w-5/6 md:text-5xl md:leading-[1.2] md:tracking-[-0.03em]">
    I’m a software engineer in Karawang, Indonesia. I write the software between factory machines and the people who
    watch them: device gateways, data pipelines and dashboards that load fast.
  </p>
  <p class="mt-6 font-mono text-[13px] leading-relaxed text-muted md:mt-8">
    Backend, IoT and full-stack · Go, Python, TypeScript, Rust
  </p>
</section>
