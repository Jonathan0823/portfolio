---
import { CONTACT_EMAIL, GITHUB_URL, LINKEDIN_URL, MAILTO_URL } from '@/lib/profile';
import { HEAT_PALETTE } from '@/lib/palette';
import { SMALL_BITMAPS, pixelIcon, type GlyphName } from '@/scripts/glyph-model';

const ICON_PX = 14;
// each icon warms to its brand colour when its link is hovered or focused
const icon = (name: GlyphName, heat: string) => ({
  ...pixelIcon(SMALL_BITMAPS[name], ICON_PX),
  style: `--heat:${heat}`,
});
const icons = {
  mail: icon('mail', HEAT_PALETTE[3]),
  git: icon('git', HEAT_PALETTE[4]),
  linkedin: icon('linkedin', HEAT_PALETTE[2]),
};
---

<script is:inline>
  // the drip builds the headline's period from nothing, so hide it before the first paint. Without JS, or with
  // reduced motion (which skips the drip), it stays visible
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('drip-pending');
</script>

<!-- phones: the hero is as tall as its content, so the next section peeks in; md and up fill the screen -->
<section id="top" class="relative flex flex-col md:h-svh md:min-h-[800px]">
  <div data-pixel-field="hero" aria-hidden="true" class="h-[300px] w-full md:h-[336px]"></div>
  <canvas data-glyph aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-[5] hidden"></canvas>
  <div class="flex flex-col justify-end gap-6 px-5 pt-8 pb-6 md:flex-1 md:gap-7 md:px-24 md:pt-0 md:pb-[72px]">
    <p class="sr-only">Eguin Jonathan, Software Engineer</p>
    <h1
      data-glyph-text
      data-intro-rise
      class="text-[clamp(84px,27vw,112px)] leading-[0.9] font-semibold tracking-[-0.06em] md:text-[168px]"
    >
      Hi, I’m
      <br />
      Eguin
      <span class="text-accent" data-drip-period>
        .
      </span>
    </h1>
    <div data-glyph-text class="flex flex-col gap-1.5 md:gap-2.5">
      <p class="font-mono text-sm leading-normal text-ink md:text-[15px]">
        Software Engineer · Backend & Full-Stack · Karawang, Indonesia (UTC+7) · open to remote roles
      </p>
      <p class="font-mono text-[13px] leading-relaxed text-muted md:text-sm">
        Latest: cut a 300M-point dashboard from 5 min to under 10 s.{' '}
        <a href="#experience" class="text-ink underline decoration-[#d4d4d4] underline-offset-4 hover:decoration-ink">
          See how ↓
        </a>
      </p>
    </div>
    <p class="flex flex-col gap-2 font-mono text-sm leading-relaxed text-muted md:flex-row md:gap-0">
      <a href={MAILTO_URL} data-glyph-for="mail" class="text-ink" style={icons.mail.style}>
        <svg
          class="link-icon"
          aria-hidden="true"
          shape-rendering="crispEdges"
          fill="currentColor"
          viewBox={icons.mail.viewBox}
          width={icons.mail.width}
          height={icons.mail.height}
        >
          <path d={icons.mail.d} />
        </svg>
        {CONTACT_EMAIL}
      </a>
      <span class="hidden md:inline">&nbsp;&nbsp;·&nbsp;&nbsp;</span>
      <span>
        <a href={GITHUB_URL} data-glyph-for="git" class="text-ink" style={icons.git.style}>
          <svg
            class="link-icon"
            aria-hidden="true"
            shape-rendering="crispEdges"
            fill="currentColor"
            viewBox={icons.git.viewBox}
            width={icons.git.width}
            height={icons.git.height}
          >
            <path d={icons.git.d} />
          </svg>
          GitHub
        </a>
      </span>
      <span class="hidden md:inline">&nbsp;&nbsp;·&nbsp;&nbsp;</span>
      <span>
        <a href={LINKEDIN_URL} data-glyph-for="linkedin" class="text-ink" style={icons.linkedin.style}>
          <svg
            class="link-icon"
            aria-hidden="true"
            shape-rendering="crispEdges"
            fill="currentColor"
            viewBox={icons.linkedin.viewBox}
            width={icons.linkedin.width}
            height={icons.linkedin.height}
          >
            <path d={icons.linkedin.d} />
          </svg>
          LinkedIn
        </a>
      </span>
    </p>
  </div>
</section>

<section class="px-5 pt-16 md:px-24 md:pt-40">
  <p class="text-[28px] leading-tight font-medium tracking-[-0.02em] text-pretty md:max-w-5/6 md:text-5xl md:leading-[1.2] md:tracking-[-0.03em]">
    I’m a software engineer in Karawang, Indonesia. I write the software between factory machines and the people who
    watch them: device gateways, data pipelines and dashboards that load fast.
  </p>
  <p class="mt-6 font-mono text-[13px] leading-relaxed text-muted md:mt-8">
    Backend, IoT and full-stack · Go, Python, TypeScript, Rust
  </p>
</section>
