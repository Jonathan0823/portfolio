---
import { CONTACT_EMAIL, GITHUB_URL, LINKEDIN_URL, MAILTO_URL } from '@/lib/profile';
import { heatIcons } from '@/lib/heat-icons';
import ButtonIcon from './ButtonIcon.astro';

// the footer's pill buttons a size down; stacked on phones and on touch
const pill =
  'btn-with-icon rounded-full border border-[#d4d4d4] px-[17px] py-[9px] text-sm leading-5 font-medium text-ink no-underline';
const icons = heatIcons(14);
---

<!-- phones: the hero is as tall as its content, so the next section peeks in; md and up fill the screen -->
<section id="top" class="relative flex flex-col md:h-svh md:min-h-[800px]">
  <div data-pixel-field="hero" aria-hidden="true" class="h-[200px] w-full md:h-[336px]"></div>
  <canvas data-glyph aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-[5] hidden"></canvas>
  <div class="flex flex-col justify-end gap-6 px-5 pt-3 pb-6 md:flex-1 md:gap-7 md:px-24 md:pt-0 md:pb-[72px]">
    <h1
      data-glyph-text
      data-intro-rise
      class="text-[clamp(84px,27vw,112px)] leading-[0.9] font-semibold tracking-[-0.06em] md:text-[168px]"
    >
      <span class="sr-only text-base">Eguin Jonathan, Software Engineer — </span>
      Hi, I’m
      <br />
      Eguin
      <span class="text-accent">.</span>
    </h1>
    <div data-glyph-text class="flex flex-col gap-1.5 md:gap-2.5">
      <p class="text-[15px] leading-normal text-ink md:text-[17px]">
        <span class="block">Backend &amp; Full-Stack Software Engineer</span>
        <span class="block">Karawang, Indonesia (UTC+7)</span>
        <span class="block">Open to remote roles</span>
      </p>
      <p class="max-w-[68ch] text-sm leading-relaxed text-muted md:text-base">
        Dashboard load: 5 min → under 10 s.{' '}
        <a href="#experience" class="text-ink underline decoration-[#d4d4d4] underline-offset-4 hover:decoration-ink">
          See how ↓
        </a>
      </p>
    </div>
    <div data-hero-links class="hero-links relative flex flex-col items-start gap-3.5 md:flex-row">
      <a
        href={MAILTO_URL}
        data-glyph-for="mail"
        data-pixel-btn="dark"
        class="btn-with-icon rounded-full bg-ink px-[18px] py-[10px] text-sm leading-5 font-medium text-paper no-underline"
        style={icons.mail.style}
      >
        <ButtonIcon icon={icons.mail} />
        {CONTACT_EMAIL}
      </a>
      <a href={GITHUB_URL} data-glyph-for="git" data-pixel-btn class={pill} style={icons.git.style}>
        <ButtonIcon icon={icons.git} />
        GitHub
      </a>
      <a href={LINKEDIN_URL} data-glyph-for="linkedin" data-pixel-btn class={pill} style={icons.linkedin.style}>
        <ButtonIcon icon={icons.linkedin} />
        LinkedIn
      </a>
    </div>
  </div>
</section>

<section class="px-5 pt-10 md:px-24 md:pt-40">
  <p class="text-[25px] leading-tight font-medium tracking-[-0.02em] text-pretty md:max-w-[min(83.333%,56ch)] md:text-5xl md:leading-[1.2] md:tracking-[-0.03em]">
    I’m a software engineer in Karawang, Indonesia. I write the software between production machines and the people who
    watch them: device gateways, data pipelines and dashboards that load fast.
  </p>
  <p class="mt-6 text-[17px] leading-[1.55] text-body text-pretty md:mt-8 md:max-w-[min(83.333%,56ch)] md:text-lg">
    I started informatics in 2023 to learn how the apps on my phone worked, fell for Go that December, and left
    university in 2025 to work full time at a battery manufacturer.
    <a
      href="/story/"
      data-cursor="next"
      class="story-link ml-2.5 font-semibold whitespace-nowrap text-accent-ink no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
    >
      Read the full story{' '}
      <span aria-hidden="true" class="story-arrow">
        →
      </span>
    </a>
  </p>
</section>

<style>
  .story-link {
    position: relative;
  }
  .story-link::before,
  .story-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.25em;
    height: 5px;
    pointer-events: none;
    -webkit-mask-image: repeating-linear-gradient(to right, #000 0 6px, transparent 6px 9px);
    mask-image: repeating-linear-gradient(to right, #000 0 6px, transparent 6px 9px);
  }
  .story-link::before {
    background: var(--color-square);
  }
  .story-link::after {
    background: linear-gradient(
      to right,
      var(--color-pixel-night),
      var(--color-pixel-indigo),
      var(--color-pixel-violet),
      var(--color-pixel-orange),
      var(--color-pixel-sun)
    );
    clip-path: inset(0 100% 0 0);
    transition: clip-path 260ms steps(10, end);
  }
  .story-arrow {
    display: inline-block;
    margin-left: 0.35em;
    transition: transform 200ms;
  }
  .story-link:focus-visible::after {
    clip-path: inset(0 0 0 0);
    transition: clip-path 420ms steps(14, end);
  }
  .story-link:focus-visible .story-arrow {
    transform: translateX(6px);
  }
  @media (hover: hover) {
    .story-link:hover::after {
      clip-path: inset(0 0 0 0);
      transition: clip-path 420ms steps(14, end);
    }
    .story-link:hover .story-arrow {
      transform: translateX(6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .story-link::after,
    .story-arrow {
      transition: none !important;
    }
  }
</style>
