---
interface Props {
  links: { href: string; label: string; sec?: string }[];
  brandHref?: string;
}
const { links, brandHref = '#top' } = Astro.props;
---

<nav aria-label="Main" class="group sticky top-0 z-40 h-0">
  <div class="relative flex items-start justify-between px-3 py-1.5 md:items-center md:px-24 md:py-2">
    <div
      data-nav-bg
      aria-hidden="true"
      class="border-line pointer-events-none absolute inset-0 -z-10 border-b bg-paper/95 opacity-0 backdrop-blur-md transition-opacity duration-200 motion-reduce:transition-none"
    ></div>

    <a
      href={brandHref}
      data-nav-magnet
      data-cursor={brandHref === '/' ? 'back' : undefined}
      aria-label={brandHref === '/' ? 'Eguin Jonathan, back to the home page' : undefined}
      class="px-3.5 py-2.5 text-[17px] font-semibold tracking-[-0.03em] whitespace-nowrap text-ink no-underline transition-colors duration-200 group-data-on-field:text-paper group-data-on-field:[text-shadow:0_1px_3px_rgb(30_27_75/0.9)] motion-reduce:transition-none"
    >
      {brandHref === '/' && <span aria-hidden="true">← </span>}Eguin Jonathan
    </a>

    <div class="hidden gap-0.5 p-1.5 text-sm md:flex">
      {links.map((l) => (
        <a
          href={l.href}
          data-sec={l.sec}
          class:list={[
            'px-3 py-1.5 no-underline [html:not(.has-pixel-pointer)_&]:hover:underline decoration-accent decoration-2 underline-offset-[6px] aria-[current=true]:underline',
            l.sec === 'contact'
              ? 'bg-ink text-paper group-data-on-field:bg-paper group-data-on-field:text-ink group-data-on-field:data-pixel-on:text-paper group-data-on-field:data-pixel-on:ring-1 group-data-on-field:data-pixel-on:ring-paper'
              : 'text-ink group-data-on-field:text-paper group-data-on-field:[text-shadow:0_1px_3px_rgb(30_27_75/0.9)]',
          ]}
          data-nav-magnet={l.sec === 'contact' ? undefined : ''}
          data-pixel-btn={l.sec === 'contact' ? 'dark' : undefined}
        >
          {l.label}
        </a>
      ))}
    </div>

    <details data-menu class="open:bg-paper group-data-on-field:not-open:text-paper relative text-sm md:hidden">
      <summary data-pixel-btn class="cursor-pointer list-none px-4 py-3 [&::-webkit-details-marker]:hidden">
        <span class="in-open:hidden">Menu</span>
        <span class="hidden in-open:inline">Close</span>
      </summary>
      <div class="border-line bg-paper absolute top-full right-0 mt-2 flex min-w-[180px] flex-col border py-1 shadow-lg">
        {links.map((l, i) => (
          <a
            href={l.href}
            data-sec={l.sec}
            style={`--i:${i + 1}`}
            class="text-ink px-4 py-2.5 font-sans text-base font-semibold tracking-[-0.02em] no-underline decoration-accent decoration-2 underline-offset-4 aria-[current=true]:underline"
          >
            {l.label}
          </a>
        ))}
      </div>
    </details>

    <div
      data-progress
      aria-hidden="true"
      class="pointer-events-none absolute top-full right-0 left-0 flex overflow-hidden opacity-0 transition-opacity duration-200 motion-reduce:transition-none"
    ></div>
  </div>
</nav>

<script>
  import { HEAT_PALETTE, hash } from '@/scripts/pixel-math';
  import { prefersReducedMotion } from '@/scripts/motion';
  import { whenCoverGone } from '@/scripts/page-cover';
  import { whenHeroPoured } from '@/scripts/hero-poured';

  /** how far down a field its lava's surface rests, as a share of its height (pixel-math's horizon) */
  const SURFACE = 0.68;
  /** where the bar starts on a page without a field */
  const SCROLLED_PX = 40;
  /** how long after the cover has gone the story strip takes to fill in behind the links (the hero says when it has poured) */
  const POURED_MS = 700;

  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-sec]')];
  const sections = [...new Set(links.map((a) => a.dataset.sec!))]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => !!el);

  const mark = () => {
    let current: string | null = null;
    for (const el of sections) if (el.getBoundingClientRect().top < innerHeight * 0.45) current = el.id;
    for (const a of links) a.setAttribute('aria-current', String(a.dataset.sec === current));
  };
  addEventListener('scroll', mark, { passive: true });
  mark();

  const nav = document.querySelector<HTMLElement>('nav[aria-label="Main"]');
  const navBg = document.querySelector<HTMLElement>('[data-nav-bg]');
  // at the top of a page that opens on a field the links sit straight on it, in white; the bar comes once the field has left
  const field = document.querySelector('[data-pixel-field="hero"], [data-pixel-field="strip"]');
  // the field is empty until it has poured in behind the links, and white on white would hide them
  let poured = false;
  const dress = () => {
    // the bar waits until the lava has left: its surface has scrolled up to the bottom of the links
    const box = field?.getBoundingClientRect();
    const scrolled = box
      ? box.top + box.height * SURFACE < (nav?.firstElementChild?.clientHeight ?? 0)
      : scrollY > SCROLLED_PX;
    if (navBg) navBg.style.opacity = scrolled ? '1' : '0';
    nav?.toggleAttribute('data-on-field', poured && !scrolled);
  };
  addEventListener('scroll', dress, { passive: true });
  addEventListener('resize', dress);
  const onField = () => {
    poured = true;
    dress();
  };
  // the hero's ignite pours for about two seconds, longer on a slow machine; white links before it lands sit on nothing
  if (field?.matches('[data-pixel-field="hero"]')) void whenHeroPoured().then(onField);
  else if (field) void whenCoverGone().then(() => setTimeout(onField, prefersReducedMotion() ? 0 : POURED_MS));
  dress();

  const bar = document.querySelector<HTMLElement>('[data-progress]');
  if (bar) {
    const heat = [5, 4, 3, 2, 1].map((i) => HEAT_PALETTE[i]);
    const hero = document.getElementById('top');
    let cells: HTMLElement[] = [];
    let lit = -1,
      frame = 0;

    const build = () => {
      const count = Math.ceil(innerWidth / 10);
      if (count === cells.length) return;
      bar.replaceChildren();
      cells = [];
      for (let i = 0; i < count; i++) {
        const cell = document.createElement('span');
        cell.style.cssText = `width:10px;height:4px;flex:none;background:${heat[Math.floor(i / 3 + hash(i, 7) * 2) % 5]}`;
        cell.className = 'opacity-0 transition-opacity duration-200 motion-reduce:transition-none';
        bar.appendChild(cell);
        cells.push(cell);
      }
      lit = -1;
    };
    const update = () => {
      frame = 0;
      const pastHero = scrollY > (hero ? hero.offsetHeight - 80 : 40);
      bar.style.opacity = pastHero ? '1' : '0';
      const max = document.documentElement.scrollHeight - innerHeight;
      const progress = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
      const count = Math.round(progress * cells.length);
      if (count === lit) return;
      cells.forEach((cell, i) => cell.classList.toggle('opacity-0', i >= count));
      lit = count;
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', () => {
      build();
      schedule();
    });
    build();
    update();
  }

  const menu = document.querySelector<HTMLDetailsElement>('details[data-menu]');
  // a dropdown closes on a tap anywhere else, or Escape
  addEventListener('pointerdown', (e) => {
    if (menu?.open && !menu.contains(e.target as Node)) menu.open = false;
  });
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu) menu.open = false;
  });
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) menu.open = false;
  });
</script>
