---
// The end of a page as exactly one screen: the sign-off (slot) centred in the space left above
// the pixel band and footer line. Sizes follow the screen height; on screens too short for the
// content it grows instead of clipping.
import PixelFooter from './PixelFooter.astro';

interface Props {
  id?: string;
}
const { id } = Astro.props;
---

<div id={id} class="flex min-h-svh flex-col">
  <section class="flex flex-1 flex-col justify-center px-5 pt-20 pb-6 md:px-24">
    <slot />
  </section>
  <PixelFooter />
</div>
