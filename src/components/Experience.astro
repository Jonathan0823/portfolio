---
import Section from './Section.astro';
import Visual from './Visual.astro';
import TechStack from './TechStack.astro';
import { cvAvailable } from '@/lib/site-data';
import { getProjects, getRoles } from '@/lib/content';
import { projectAnchor, projectForAchievement } from '@/lib/projects';
import { formatDuration, formatRange, monthOf, roleSquares } from '@/lib/role-timeline';

const currentMonth = monthOf(new Date());
const projects = await getProjects();

const work = (await getRoles('work')).map((role) => {
  const squares = roleSquares(role, currentMonth);
  return {
    role,
    squares,
    range: formatRange(role.data.start, role.data.end),
    duration: formatDuration(squares.length),
  };
});
const cv = cvAvailable();
const place = (r: { org: string; location?: string }) => [r.org, r.location].filter(Boolean).join(', ');
const summary = (sq: { hasAchievement: boolean }[]) =>
  `${sq.length} months, ${sq.filter((q) => q.hasAchievement).length} with a result listed`;
---

<Section id="experience" title="Experience.">
  <div
    slot="aside"
    class="flex flex-wrap items-baseline gap-x-6 gap-y-2 text-[15px] leading-relaxed text-muted md:justify-end"
  >
    <p class="flex items-center gap-4">
      <span class="flex items-center gap-1.5">
        <span aria-hidden="true" class="size-2.5 bg-square"></span>month
      </span>
      <span class="flex items-center gap-1.5">
        <span aria-hidden="true" class="size-2.5 bg-accent"></span>result shipped
      </span>
    </p>
    {cv && (
      <a href="/cv.pdf" class="text-ink">
        <span class="md:hidden">CV (PDF)</span>
        <span class="hidden md:inline">Download CV (PDF)</span>
      </a>
    )}
  </div>
  {work.map(({ role, squares, range, duration }) => (
    <div data-role class="grid grid-cols-12 gap-x-6 border-t border-ink pt-8 pb-4 md:py-10">
      <div class="col-span-12 flex flex-col md:sticky md:top-24 md:col-span-3 md:gap-2.5 md:self-start">
        <p class="flex flex-wrap gap-x-4 gap-y-2 text-[15px] leading-relaxed text-muted">
          <span>{range}</span>
          <span>{duration}</span>
        </p>
        <div class="hidden max-w-[204px] flex-wrap gap-[3px] md:flex" role="img" aria-label={summary(squares)}>
          {squares.map((q) => (
            <span
              data-sq
              class:list={['sq size-3.5', q.hasAchievement ? 'bg-accent' : 'bg-square']}
              title={q.label}
            ></span>
          ))}
        </div>
      </div>
      <div class="col-span-12 flex flex-col md:col-span-9">
        <h3 class="mt-2.5 text-[28px] leading-[1.1] font-semibold tracking-[-0.03em] md:text-[32px] md:mt-0">
          {role.data.title}
        </h3>
        <p class="mt-1 text-[15px] leading-relaxed text-muted md:pb-3">{place(role.data)}</p>
        <div class="my-4 flex max-w-[156px] flex-wrap gap-[3px] md:hidden" role="img" aria-label={summary(squares)}>
          {squares.map((q) => (
            <span
              data-sq
              class:list={['sq size-2.5', q.hasAchievement ? 'bg-accent' : 'bg-square']}
              title={q.label}
            ></span>
          ))}
        </div>
        {role.data.achievements.map((a, i) => {
          const published = projectForAchievement(projects, a.id);
          return (
            <div
              id={a.id}
              class:list={[i >= 3 && 'role-extra']}
              class="border-t border-line-soft py-3.5 md:-mx-3 md:px-3"
            >
              <p class="max-w-[68ch] text-[17px] leading-[1.55] md:text-lg text-body text-pretty">{a.text}</p>
              {a.tags.length > 0 && (
                <div aria-label="Tech stack" role="group" class="mt-2.5 text-[15px] leading-relaxed text-muted">
                  <TechStack tags={a.tags} />
                </div>
              )}
              {published && (
                <p class="mt-2 text-[15px] leading-relaxed text-muted">
                  Open-source version:{' '}
                  <a
                    href={`#${projectAnchor(published.id)}`}
                    class="inline-flex items-center text-ink underline decoration-line underline-offset-4 hover:decoration-ink max-md:min-h-11"
                  >
                    {published.data.name} ↗
                  </a>
                </p>
              )}
              {a.story && (
                <details class="group mt-1 md:mt-0">
                  <summary class="flex min-h-11 cursor-pointer list-none items-center gap-1 text-[15px] leading-relaxed text-ink [&::-webkit-details-marker]:hidden">
                    How I did it
                    <span aria-hidden="true" class="group-open:hidden">
                      +
                    </span>
                    <span aria-hidden="true" class="hidden group-open:inline">
                      −
                    </span>
                  </summary>
                  <div class:list={['grid gap-6 pt-3 pb-2', a.visual?.src && 'md:grid-cols-[1.1fr_1fr]']}>
                    {a.visual?.src && <Visual visual={a.visual} />}
                    <div class="flex flex-col gap-4">
                      {a.story.map((para) => (
                        <p class="max-w-[68ch] text-[17px] leading-[1.55] md:text-lg text-body">{para}</p>
                      ))}
                    </div>
                  </div>
                </details>
              )}
            </div>
          );
        })}
        {role.data.achievements.length > 3 && (
          <button
            type="button"
            data-showall
            class="role-showall cursor-pointer border-t border-line-soft py-3 text-left text-[15px] leading-relaxed text-ink"
          >
            Show all ({role.data.achievements.length}) +
          </button>
        )}
      </div>
    </div>
  ))}
</Section>

<style is:global>
  /* phones show a role's three newest achievements; the rest open with the button. md and up always show all */
  .role-showall {
    display: none;
  }
  @media (max-width: 767px) {
    [data-role]:not([data-all]) .role-extra {
      display: none;
    }
    [data-role]:not([data-all]) .role-showall {
      display: block;
      min-height: 44px;
    }
  }
</style>

<script>
  document
    .querySelectorAll<HTMLElement>('#experience [data-showall]')
    .forEach((b) =>
      b.addEventListener('click', () => b.closest<HTMLElement>('[data-role]')!.setAttribute('data-all', '')),
    );
  const groups = document.querySelectorAll<HTMLElement>('#experience [role=img]');
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const squares = document.querySelectorAll<HTMLElement>('#experience [data-sq]');
    squares.forEach((s) => s.classList.add('sq-hidden'));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          io.unobserve(e.target);
          e.target
            .querySelectorAll<HTMLElement>('[data-sq]')
            .forEach((s, i) => setTimeout(() => s.classList.remove('sq-hidden'), i * 35));
        }
      },
      { threshold: 0.3 },
    );
    groups.forEach((g) => io.observe(g));
  }
</script>
