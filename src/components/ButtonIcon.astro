---
// The pixel icon before a button's label (hero contact links and closing buttons); takes the button's heat colour
// (global.css) on hover, focus and while the button's logo is on show.
import type { PixelIcon } from '@/scripts/glyph-model';

interface Props {
  icon: PixelIcon;
}
const { icon } = Astro.props;
---

<svg
  class="btn-icon"
  aria-hidden="true"
  shape-rendering="crispEdges"
  fill="currentColor"
  viewBox={icon.viewBox}
  width={icon.width}
  height={icon.height}
>
  <path d={icon.d} />
</svg>
