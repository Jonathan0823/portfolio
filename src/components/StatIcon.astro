---
import { statIcon, type StatIconName } from '@/lib/stat-icons';
import { runsPath } from '@/lib/skill-icons';

interface Props {
  name: StatIconName;
}
const icon = statIcon(Astro.props.name);
// one path per colour in each frame
const frames = icon.cells.map((cells) =>
  [...new Set(cells.map((c) => c.fill))].map((fill) => {
    const lit = new Array<boolean>(icon.width * icon.height).fill(false);
    for (const c of cells) if (c.fill === fill) lit[c.y * icon.width + c.x] = true;
    return { fill, d: runsPath(lit, icon.width) };
  }),
);
---

<svg
  viewBox={`0 0 ${icon.width} ${icon.height}`}
  aria-hidden="true"
  shape-rendering="crispEdges"
  class="stat-icon h-9 w-auto md:h-14"
  style={`--loop:${icon.loop}s`}
>
  {frames.map((frame, i) => (
    <g class="frame" style={`--at:${(i / frames.length) * 100}%`} data-frame={i}>
      {frame.map((p) => (
        <path d={p.d} fill={p.fill} />
      ))}
    </g>
  ))}
</svg>

<style>
  .frame:not(:first-child) {
    visibility: hidden;
  }
  /* two frames swap on a hard step, so it reads as pixel animation rather than a tween */
  .frame {
    animation: swap var(--loop) steps(1, end) infinite;
  }
  .frame:last-child {
    animation-name: swap-b;
  }
  @keyframes swap {
    0%,
    49.99% {
      visibility: visible;
    }
    50%,
    100% {
      visibility: hidden;
    }
  }
  @keyframes swap-b {
    0%,
    49.99% {
      visibility: hidden;
    }
    50%,
    100% {
      visibility: visible;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .frame {
      animation: none;
    }
  }
</style>
