---
import { CONTACT_EMAIL, GITHUB_URL, LINKEDIN_URL, MAILTO_URL } from '../lib/profile';
import { cvAvailable } from '../lib/site-data';

const cv = cvAvailable();
const pill = 'rounded-full border border-[#d4d4d4] px-[23px] py-[15px] text-base font-medium no-underline';
---

<section id="contact" class="px-5 pt-[120px] md:px-24 md:pt-[176px]">
  <h2 class="max-w-[12ch] text-[56px] leading-[0.95] font-semibold tracking-[-0.055em] text-balance md:max-w-[16ch] md:text-[120px] md:leading-[0.92]">
    Let’s build something that holds up<span class="text-accent">.</span>
  </h2>
  <p class="mt-10 max-w-[34ch] text-xl leading-[1.45] tracking-[-0.01em] md:text-[26px]">
    Backend roles, data-heavy systems, or a machine that needs to talk to a screen. I’d like to hear about it.
  </p>
  <p class="mt-8 text-4xl font-semibold tracking-[-0.04em]">Eguin Jonathan</p>
  <div class="mt-6 flex flex-wrap gap-2.5 md:gap-3">
    <a href={MAILTO_URL} data-pixel-btn="dark" class="rounded-full bg-ink px-6 py-4 text-base font-medium text-paper no-underline">{CONTACT_EMAIL}</a>
    <a href={GITHUB_URL} data-pixel-btn class={pill}>GitHub</a>
    <a href={LINKEDIN_URL} data-pixel-btn class={pill}>LinkedIn</a>
    {cv && <a href="/cv.pdf" data-pixel-btn class={pill}>Résumé</a>}
  </div>
</section>

<footer class="flex flex-col gap-1 px-5 pt-[72px] pb-10 font-mono text-[13px] leading-relaxed text-muted md:flex-row md:justify-between md:px-24 md:pt-24 md:pb-12">
  <p>Eguin Jonathan · Karawang, Indonesia · UTC+7</p>
  <p>Indonesian · English · a little Japanese</p>
</footer>
