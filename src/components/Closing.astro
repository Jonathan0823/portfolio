---
import { CONTACT_EMAIL, GITHUB_URL, LINKEDIN_URL, MAILTO_URL } from '@/lib/profile';
import { cvAvailable } from '@/lib/site-data';
import { heatIcons } from '@/lib/heat-icons';
import ButtonIcon from './ButtonIcon.astro';
import PixelFooter from './PixelFooter.astro';

interface Props {
  headline: string;
}
const { headline } = Astro.props;

const cv = cvAvailable();
const pill =
  'btn-with-icon rounded-full border border-[#d4d4d4] px-[23px] py-[15px] text-base font-medium no-underline';
const icons = heatIcons(15);
---

<div id="contact" class="flex min-h-svh flex-col">
  <section class="flex flex-1 flex-col justify-center px-5 pt-20 pb-6 md:px-24">
    <h2 class="max-w-[12ch] text-[56px] leading-[0.95] font-semibold tracking-[-0.055em] text-balance md:text-[clamp(56px,11svh,112px)] md:leading-[0.92] md:max-w-[18ch]">
      {headline}
      <span class="text-accent">.</span>
    </h2>
    <p class="mt-[clamp(16px,3svh,32px)] max-w-[34ch] text-xl leading-[1.45] tracking-[-0.01em] md:text-[clamp(18px,2.6svh,26px)]">
      Remote backend or full-stack roles. I’d like to hear about it.
    </p>
    <div class="mt-[clamp(20px,4svh,40px)] flex flex-wrap gap-2.5 md:gap-3">
      <a
        href={MAILTO_URL}
        data-pixel-btn="dark"
        class="btn-with-icon rounded-full bg-ink px-6 py-4 text-base font-medium text-paper no-underline"
        style={icons.mail.style}
      >
        <ButtonIcon icon={icons.mail} />
        {CONTACT_EMAIL}
      </a>
      <a href={GITHUB_URL} data-pixel-btn class={pill} style={icons.git.style}>
        <ButtonIcon icon={icons.git} />
        GitHub
      </a>
      <a href={LINKEDIN_URL} data-pixel-btn class={pill} style={icons.linkedin.style}>
        <ButtonIcon icon={icons.linkedin} />
        LinkedIn
      </a>
      {cv && (
        <a href="/cv.pdf" data-pixel-btn class={pill} style={icons.resume.style}>
          <ButtonIcon icon={icons.resume} />
          Résumé
        </a>
      )}
    </div>
  </section>
  <PixelFooter />
</div>
