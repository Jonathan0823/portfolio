---
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<section id={id} class="px-5 pt-[120px] md:px-24 md:pt-[200px]">
  <div class="flex items-baseline justify-between pb-5 md:pb-8">
    <h2 class="text-[40px] leading-none font-semibold tracking-[-0.04em] md:text-[64px]">{title}</h2>
    <slot name="aside" />
  </div>
  <slot />
</section>
