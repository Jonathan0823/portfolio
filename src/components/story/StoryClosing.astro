---
import { CONTACT_EMAIL, GITHUB_URL, MAILTO_URL } from '../../lib/profile';

const pill = 'rounded-full px-6 py-4 text-base font-medium no-underline';
---

<section class="px-5 pt-24 md:px-24 md:pt-44">
  <h2 class="max-w-[12ch] text-6xl leading-[0.92] font-semibold tracking-[-0.055em] text-balance md:text-[120px]">
    That’s the story so far<span class="text-accent">.</span>
  </h2>
  <p class="mt-8 max-w-[34ch] text-xl leading-[1.45] tracking-[-0.01em] md:mt-10 md:text-[26px]">
    Backend roles, data-heavy systems, or a machine that needs to talk to a screen. I’d like to hear about it.
  </p>
  <p class="mt-8 text-3xl font-semibold tracking-[-0.04em] md:text-4xl">Eguin</p>
  <div class="mt-6 flex flex-wrap gap-3">
    <a href={MAILTO_URL} class={`bg-ink text-paper ${pill}`}>{CONTACT_EMAIL}</a>
    <a href={GITHUB_URL} class={`border-ink border ${pill}`}>GitHub</a>
  </div>
</section>
<footer
  class="text-muted flex flex-col gap-2 px-5 pt-24 pb-12 font-mono text-[13px] leading-relaxed md:flex-row md:justify-between md:px-24"
>
  <p>Eguin Jonathan · Karawang, Indonesia · UTC+7</p>
  <p>Indonesian · English · a little Japanese</p>
</footer>
