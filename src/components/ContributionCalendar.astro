---
import { HEAT_PALETTE } from '@/lib/palette';
import { calendarLabel, cellPosition, dayTooltip, levelThresholds, relativeLevel, type GithubStats } from '@/lib/github';

interface Props {
  calendar: GithubStats['calendar'];
}
const { calendar } = Astro.props;
const cols = calendar.weeks.length;
const cell = 12;
const EMPTY = '#F1F1F1';
const thresholds = levelThresholds(calendar.weeks.flatMap((w) => w.days.map((d) => d.count)));
const cells = calendar.weeks.flatMap((w, i) =>
  w.days.map((d) => {
    const { col, row } = cellPosition(d.date, i);
    const level = relativeLevel(d.count, thresholds);
    return { x: col * cell + 1, y: row * cell + 1, col, row, level, fill: level < 0 ? EMPTY : HEAT_PALETTE[level], tip: dayTooltip(d.date, d.count) };
  }),
);
---

<figure class="relative" data-calendar data-cursor="cross">
  <svg
    role="img"
    aria-label={calendarLabel(calendar.total)}
    viewBox={`0 0 ${cols * cell} ${7 * cell}`}
    class="block h-auto w-full overflow-visible"
  >
    {cells.map((c) => (
      <rect x={c.x} y={c.y} width={cell - 2} height={cell - 2} fill={c.fill} data-tip={c.tip} data-col={c.col} data-row={c.row} data-level={c.level} />
    ))}
  </svg>
  <div
    data-calendar-tip
    class="pointer-events-none absolute top-0 left-0 rounded-lg bg-ink px-3 py-2 font-mono text-xs whitespace-nowrap text-white opacity-0 transition-opacity duration-150"
    aria-hidden="true"
  >
  </div>
  <figcaption class="mt-3 flex items-center justify-end gap-0 font-mono text-[13px] leading-relaxed text-muted" data-legend>
    <span class="mr-1">Less</span>
    {HEAT_PALETTE.map((color, level) => (
      <button type="button" data-legend-level={level} aria-pressed="false" aria-label={`Show only level ${level + 1} of 6`} class="group grid size-6 cursor-pointer place-items-center">
        <span class="size-3.5 group-aria-pressed:outline-2 group-aria-pressed:outline-offset-1 group-aria-pressed:outline-ink" style={`background:${color}`}></span>
      </button>
    ))}
    <span class="ml-1">More</span>
  </figcaption>
</figure>

<style>
  [data-calendar] rect {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 160ms cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 300ms,
      fill 600ms;
  }
  [data-calendar] rect.is-hot {
    transition: transform 160ms cubic-bezier(0.2, 0.7, 0.2, 1), opacity 300ms, fill 0ms;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-calendar] rect {
      transition: none;
    }
  }
</style>

<script>
  import { HEAT_PALETTE } from '@/lib/palette';
  import { canRunTrail, prefersReducedMotion } from '@/scripts/motion';

  const LENS = 3;
  const COOL_MS = 900;

  for (const fig of document.querySelectorAll<HTMLElement>('[data-calendar]')) {
    const tip = fig.querySelector<HTMLElement>('[data-calendar-tip]');
    const svg = fig.querySelector('svg');
    if (!tip || !svg) continue;
    const rects = [...svg.querySelectorAll<SVGRectElement>('rect')];
    const grid = new Map(rects.map((r) => [`${r.dataset.col},${r.dataset.row}`, r]));
    const baseFill = new Map(rects.map((r) => [r, r.getAttribute('fill')!]));
    const columns = Math.max(...rects.map((r) => Number(r.dataset.col))) + 1;
    const lens = canRunTrail();
    let lifted: SVGRectElement[] = [];
    const cooling = new Map<SVGRectElement, number>();

    if (!prefersReducedMotion() && 'IntersectionObserver' in window) {
      rects.forEach((r) => (r.style.opacity = '0'));
      const io = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        rects.forEach((r, i) => setTimeout(() => (r.style.opacity = ''), (i / rects.length) * 1100));
      }, { threshold: 0.4 });
      io.observe(svg);
    }

    const heatUp = (rect: SVGRectElement) => {
      const level = Number(rect.dataset.level);
      rect.classList.add('is-hot');
      rect.setAttribute('fill', HEAT_PALETTE[Math.min(5, Math.max(1, level + 2))]);
      clearTimeout(cooling.get(rect));
      cooling.set(rect, window.setTimeout(() => {
        rect.classList.remove('is-hot');
        rect.setAttribute('fill', baseFill.get(rect)!);
      }, COOL_MS));
    };

    const onMove = (e: PointerEvent) => {
      const text = (e.target as Element).getAttribute?.('data-tip');
      const box = fig.getBoundingClientRect();
      if (text) {
        const x = Math.min(e.clientX - box.left + 12, box.width - 260);
        tip.textContent = text;
        tip.style.transform = `translate(${Math.max(0, x)}px, ${e.clientY - box.top - 52}px)`;
        tip.style.opacity = '1';
      } else tip.style.opacity = '0';
      if (!lens) return;
      const svgBox = svg.getBoundingClientRect();
      const size = svgBox.width / columns;
      const px = (e.clientX - svgBox.left) / size, py = (e.clientY - svgBox.top) / size;
      lifted.forEach((r) => (r.style.transform = ''));
      lifted = [];
      for (let c = Math.floor(px - LENS); c <= px + LENS; c++) {
        for (let r = Math.floor(py - LENS); r <= py + LENS; r++) {
          const rect = grid.get(`${c},${r}`);
          if (!rect) continue;
          const d = Math.hypot(c + 0.5 - px, r + 0.5 - py) / LENS;
          if (d >= 1) continue;
          rect.style.transform = `translateY(${-2.5 * (1 - d)}px) scale(${1 + 0.35 * (1 - d)})`;
          lifted.push(rect);
          if (d < 0.3) heatUp(rect);
        }
      }
    };
    fig.addEventListener('pointermove', onMove);
    fig.addEventListener('pointerleave', () => {
      tip.style.opacity = '0';
      lifted.forEach((r) => (r.style.transform = ''));
      lifted = [];
    });

    const buttons = [...fig.querySelectorAll<HTMLButtonElement>('[data-legend-level]')];
    let pinned: number | null = null;
    const filter = (level: number | null) => {
      rects.forEach((r) => (r.style.opacity = level === null || Number(r.dataset.level) === level ? '' : '0.12'));
    };
    buttons.forEach((b) => {
      const level = Number(b.dataset.legendLevel);
      b.addEventListener('pointerenter', () => filter(level));
      b.addEventListener('pointerleave', () => filter(pinned));
      b.addEventListener('click', () => {
        pinned = pinned === level ? null : level;
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(Number(x.dataset.legendLevel) === pinned)));
        filter(pinned);
      });
    });
  }
</script>
