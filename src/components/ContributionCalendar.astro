---
import { HEAT_PALETTE } from '@/lib/palette';
import { GITHUB_LOGIN, GITHUB_URL } from '@/lib/profile';
import { CAL } from '@/scripts/ripple';
import {
  calendarLabel,
  cellPosition,
  dayTooltip,
  levelThresholds,
  relativeLevel,
  type GithubStats,
} from '@/lib/github';

interface Props {
  calendar: GithubStats['calendar'];
}
const { calendar } = Astro.props;
const { cell, gutter, top: labelH } = CAL;
const cols = calendar.weeks.length;
const EMPTY = '#F1F1F1';
const thresholds = levelThresholds(calendar.weeks.flatMap((w) => w.days.map((d) => d.count)));
const cells = calendar.weeks.flatMap((w, i) =>
  w.days.map((d) => {
    const { col, row } = cellPosition(d.date, i);
    const level = relativeLevel(d.count, thresholds);
    return {
      x: gutter + col * cell + 1,
      y: labelH + row * cell + 1,
      col,
      row,
      level,
      count: d.count,
      date: d.date,
      fill: level < 0 ? EMPTY : HEAT_PALETTE[level],
      tip: dayTooltip(d.date, d.count),
    };
  }),
);
let lastMonth = -1;
const months = calendar.weeks.flatMap((w, i) => {
  const m = new Date(w.days[0].date + 'T00:00:00Z').getUTCMonth();
  if (m === lastMonth) return [];
  lastMonth = m;
  return i > cols - 3
    ? []
    : [{ col: i, label: new Date(Date.UTC(2000, m, 1)).toLocaleString('en-GB', { month: 'short', timeZone: 'UTC' }) }];
});
const dayLabels = [
  { row: 1, label: 'Mon' },
  { row: 3, label: 'Wed' },
  { row: 5, label: 'Fri' },
];
---

<figure class="relative" data-calendar>
  <div class="mb-6 flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
    <div class="flex items-center gap-4 md:gap-5">
      <svg viewBox="0 0 16 16" aria-hidden="true" class="size-9 shrink-0 md:size-14">
        <path
          fill="currentColor"
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
        ></path>
      </svg>
      <div class="flex flex-col gap-1.5">
        <p data-count-up class="text-4xl leading-none font-semibold tracking-[-0.05em] tabular-nums md:text-[56px]">
          {calendar.total.toLocaleString('en-US')}
        </p>
        <p class="text-base text-muted-strong">contributions on GitHub in the last 12 months</p>
      </div>
    </div>
    <a
      href={GITHUB_URL}
      target="_blank"
      rel="noopener"
      class="text-base underline underline-offset-4 hover:text-muted-strong"
    >
      @{GITHUB_LOGIN} on GitHub ↗
    </a>
  </div>

  <p data-readout aria-live="polite" class="sr-only"></p>
  <div data-scroller class="overflow-x-auto pb-1">
    <div class="relative w-full min-w-[1100px] md:min-w-[640px]">
      <svg
        data-graph
        data-cursor-own-click
        role="group"
        tabindex="0"
        aria-label={calendarLabel(calendar.total)}
        viewBox={'0 0 ' + (gutter + cols * cell) + ' ' + (labelH + 7 * cell)}
        class="block h-auto w-full overflow-visible select-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink [&:focus:not(:focus-visible)]:outline-none"
      >
        {months.map((m) => (
          <text x={gutter + m.col * cell} y={9} font-size="9" class="fill-muted font-mono">
            {m.label}
          </text>
        ))}
        {dayLabels.map((d) => (
          <text x={0} y={labelH + d.row * cell + 9} font-size="9" class="fill-muted font-mono">
            {d.label}
          </text>
        ))}
        {cells.map((c) => (
          <rect
            x={c.x}
            y={c.y}
            width={cell - 2}
            height={cell - 2}
            fill={c.fill}
            data-tip={c.tip}
            data-col={c.col}
            data-row={c.row}
            data-level={c.level}
            data-count={c.count}
            data-date={c.date}
          />
        ))}
      </svg>
      <div data-grab aria-hidden="true" class="absolute hidden size-11 touch-none"></div>
    </div>
  </div>
  <div
    data-calendar-tip
    class="pointer-events-none absolute top-0 left-0 z-10 rounded-lg bg-ink px-3 py-2 font-mono text-xs whitespace-nowrap text-white opacity-0 transition-opacity duration-150"
    aria-hidden="true"
  ></div>

  <figcaption class="mt-3 flex flex-wrap items-center justify-end gap-3 font-mono text-[13px] leading-relaxed text-muted">
    <span class="flex items-center">
      <span class="mr-1">Less</span>
      {HEAT_PALETTE.map((color) => (
        <span class="mx-0.5 size-3.5" style={'background:' + color}></span>
      ))}
      <span class="ml-1">More</span>
    </span>
  </figcaption>
</figure>

<style>
  [data-calendar] rect[data-col] {
    transform-box: fill-box;
    transform-origin: center;
  }
</style>

<script>
  import { HEAT_PALETTE } from '@/lib/palette';
  import { prefersReducedMotion } from '@/scripts/motion';
  import { SHOCKWAVE_EVENT, type ShockwaveDetail } from '@/scripts/cursor-math';
  import {
    CAL,
    gridCell,
    gridPoint,
    lift,
    liveWaves,
    spotlight,
    stepToward,
    waveStrength,
    WAVES,
    type Wave,
  } from '@/scripts/ripple';

  // The graph only ripples at moments that mean something (arriving, leaving, a click, and once as it scrolls into view);
  // moving across it just shows the tooltip.
  const EDGE_COOLDOWN_MS = 900;
  // while the mouse is over the graph the cells away from it dim, so the cursor stays readable against the heat colours
  const SPOT_FADE_MS = 150;
  // the day under the pointer is marked: it grows, rises and gets an outline, easing in and out per cell
  const PICK_FADE_MS = 120;
  const PICK_SCALE = 1.6;
  // a tap that moves less than this selects a day; more is a swipe
  const TAP_SLOP = 8;
  // the touch grab target is at least this big, whatever the cell size
  const GRAB = 44;
  // while scrubbing, a finger this close to the scroller's edge scrolls it, up to MAX_SCROLL px a frame
  const EDGE_ZONE = 56;
  const MAX_SCROLL = 12;

  for (const fig of document.querySelectorAll<HTMLElement>('[data-calendar]')) {
    const svg = fig.querySelector<SVGSVGElement>('svg[data-graph]');
    const tip = fig.querySelector<HTMLElement>('[data-calendar-tip]');
    if (!svg || !tip) continue;
    const cells = [...svg.querySelectorAll<SVGRectElement>('rect[data-col]')].map((el) => ({
      el,
      col: Number(el.dataset.col),
      row: Number(el.dataset.row),
      level: Number(el.dataset.level),
      fill: el.getAttribute('fill')!,
      /** 0..1: how selected the cell is, easing toward its target */
      pick: 0,
      /** what is on the element now, so a frame only writes what changed (restyling every cell every frame is what makes the sweep heavy) */
      shown: { opacity: '' },
      /** the cell's centre, in the graph's own units */
      mx: Number(el.getAttribute('x')) + (CAL.cell - 2) / 2,
      my: Number(el.getAttribute('y')) + (CAL.cell - 2) / 2,
    }));
    // the wave is drawn here, on one canvas over the graph, instead of restyling the cells it passes over
    const canvas = document.createElement('canvas');
    canvas.setAttribute('aria-hidden', 'true');
    canvas.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;pointer-events:none';
    svg.after(canvas);
    const ctx = canvas.getContext('2d')!;
    let painted = false;
    const fitCanvas = () => {
      const dpr = Math.min(2, devicePixelRatio || 1);
      const w = svg.clientWidth,
        h = svg.clientHeight;
      if (!w || !h) return;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      const k = (w / svg.viewBox.baseVal.width) * dpr;
      ctx.setTransform(k, 0, 0, k, 0, 0);
      painted = false;
    };
    new ResizeObserver(fitCanvas).observe(svg);
    fitCanvas();
    const byPosition = new Map(cells.map((c) => [c.col + ',' + c.row, c]));
    const columns = Math.max(...cells.map((c) => c.col)) + 1;
    const reduced = prefersReducedMotion();
    let waves: Wave[] = [];
    let raf = 0;
    const spot = { col: 0, row: 0, amount: 0, target: 0, last: 0 };
    // cells near the cursor rise: they are redrawn on a layer above the grid so a raised cell overlaps its neighbours, not the reverse
    const layer = document.createElementNS('http://www.w3.org/2000/svg', 'g');
    layer.style.pointerEvents = 'none';
    svg.appendChild(layer);
    const raised = new Map<SVGRectElement, SVGRectElement>();
    let selected: (typeof cells)[number] | null = null;
    let hover: (typeof cells)[number] | null = null;
    let chosen: (typeof cells)[number] | null = null;
    // whether a mouse click made the chosen day: only such a day goes when the mouse leaves
    let clicked = false;
    // set by the last touch: only then is the grab target shown
    let touched = false;
    let start: { x: number; y: number } | null = null;
    let moved = false;
    // the pointer that began the current touch gesture; other fingers are ignored until it ends
    let pid = -1;
    const readout = fig.querySelector<HTMLElement>('[data-readout]')!;
    const scroller = fig.querySelector<HTMLElement>('[data-scroller]')!;
    const grab = fig.querySelector<HTMLElement>('[data-grab]')!;

    const frame = (now: number) => {
      const dt = now - (spot.last || now);
      const step = reduced ? 1 : Math.min(1, dt / SPOT_FADE_MS);
      spot.last = now;
      spot.amount = stepToward(spot.amount, spot.target, step);
      const pickStep = reduced ? 1 : Math.min(1, dt / PICK_FADE_MS);
      let settling = false;
      if (painted) ctx.clearRect(0, 0, svg.viewBox.baseVal.width, svg.viewBox.baseVal.height);
      painted = false;
      for (const c of cells) {
        const pickTarget = c === selected ? 1 : 0;
        c.pick = stepToward(c.pick, pickTarget, pickStep);
        if (c.pick !== pickTarget) settling = true;
        const w = waveStrength(waves, c.col, c.row, now);
        // a wave lights the cell back up through the dim
        const dim =
          spot.amount > 0 ? spotlight(Math.hypot(c.col + 0.5 - spot.col, c.row + 0.5 - spot.row), spot.amount) : 1;
        const opacity = Math.max(dim, w);
        const rise =
          spot.amount > 0 ? lift(Math.hypot(c.col + 0.5 - spot.col, c.row + 0.5 - spot.row), spot.amount) : 0;
        const level = c.level < 0 ? (w > 0.35 ? 1 : -1) : Math.min(5, c.level + Math.round(w * 3));
        const fill = level < 0 ? c.fill : HEAT_PALETTE[level];
        const pick = c.pick;
        const base = 1 + 0.8 * w + 0.15 * rise;
        const scale = base + (PICK_SCALE - base) * pick;
        let clone = raised.get(c.el);
        if (rise > 0.02 || pick > 0.01) {
          if (!clone) {
            const body = c.el.cloneNode() as SVGRectElement;
            body.removeAttribute('data-tip');
            layer.append(body);
            raised.set(c.el, (clone = body));
          }
          const body = clone;
          // the neighbours only swell a little, so the selected day stands clear of them
          const raise = Math.max(0.3 * rise, pick);
          const lifted = 0.8 * rise + 3.2 * pick;
          const shadow = 0.45 + 0.2 * pick;
          c.el.style.opacity = c.shown.opacity = '0';
          body.style.opacity = '1';
          body.setAttribute('fill', fill);
          // the stroke is divided by the scale so it stays 2px on screen
          body.setAttribute('stroke', '#ffffff');
          body.setAttribute('stroke-width', String(2 / scale));
          body.setAttribute('stroke-opacity', String(pick));
          const transform = `translateY(${-lifted}px) scale(${scale})`;
          body.style.transform = transform;
          body.style.filter = `drop-shadow(0 ${3 * raise + 2 * pick}px ${1.5 * raise + pick}px rgba(17,17,17,${shadow}))`;
          continue;
        }
        if (clone) {
          clone.remove();
          raised.delete(c.el);
        }
        // the wave is not drawn on the cell: it goes on the canvas above the graph, so the svg is only restyled for the dim
        const nextOpacity = dim < 1 ? (Math.round(dim * 50) / 50).toString() : '';
        if (c.shown.opacity !== nextOpacity) c.el.style.opacity = c.shown.opacity = nextOpacity;
        if (w > 0.03) {
          // composited over the dimmed cell below, so the two together show what max(dim, w) asked for
          ctx.globalAlpha = dim < 1 ? Math.max(0, (Math.max(dim, w) - dim) / (1 - dim)) : 1;
          ctx.fillStyle = fill;
          const side = (CAL.cell - 2) * scale;
          ctx.fillRect(c.mx - side / 2, c.my - side / 2, side, side);
          painted = true;
        }
      }
      // the selected day stays on top of its raised neighbours, or their edges would cut across its outline
      const top = selected && raised.get(selected.el);
      if (top && layer.lastChild !== top) layer.append(top);
      waves = liveWaves(waves, now);
      raf = waves.length || spot.amount !== spot.target || settling ? requestAnimationFrame(frame) : 0;
      if (!raf) spot.last = 0;
    };
    const ripple = (col: number, row: number, kind: keyof typeof WAVES) => {
      if (reduced) return;
      waves.push({ col, row, at: performance.now(), ...WAVES[kind] });
      raf ||= requestAnimationFrame(frame);
    };
    /** the grid cell under the pointer, even when it is over a gap between cells */
    const under = (e: { clientX: number; clientY: number }) => {
      const box = svg.getBoundingClientRect(),
        vb = svg.viewBox.baseVal;
      return gridCell(
        ((e.clientX - box.left) / box.width) * vb.width,
        ((e.clientY - box.top) / box.height) * vb.height,
        columns,
      );
    };

    let quietUntil = 0;
    const edge = (e: PointerEvent) => {
      if (e.pointerType !== 'mouse' || performance.now() < quietUntil) return;
      quietUntil = performance.now() + EDGE_COOLDOWN_MS;
      const { col, row } = under(e);
      ripple(col, row, 'edge');
    };
    const cellAt = (e: { clientX: number; clientY: number }) => {
      const { col, row } = under(e);
      return byPosition.get(col + ',' + row) ?? null;
    };
    // the hovered day (mouse) wins over the chosen day (a click, a tap, a scrub or an arrow key); a mouse leaving clears only a clicked one
    const show = () => {
      selected = hover ?? chosen;
      // read out to screen readers; on screen the day is named by the tooltip
      readout.textContent = selected?.el.dataset.tip ?? '';
      raf ||= requestAnimationFrame(frame);
      placeGrab();
      placeTip();
    };
    const openTip = (text: string, x: number, y: number) => {
      tip.textContent = text;
      const room = fig.clientWidth - tip.offsetWidth;
      tip.style.transform = `translate(${Math.max(0, Math.min(x, room))}px,${y}px)`;
      tip.style.opacity = '1';
    };
    /** a day chosen by touch or keyboard has no cursor to follow: its tooltip sits above the cell (a hovering mouse places its own) */
    const placeTip = () => {
      if (hover) return;
      const r = chosen?.el.getBoundingClientRect();
      const view = scroller.getBoundingClientRect();
      const x = r ? r.left + r.width / 2 : 0;
      if (!chosen || !r || x < view.left || x > view.right) {
        tip.style.opacity = '0';
        return;
      }
      const fb = fig.getBoundingClientRect();
      tip.textContent = chosen.el.dataset.tip!;
      openTip(chosen.el.dataset.tip!, x - fb.left - tip.offsetWidth / 2, r.top - fb.top - tip.offsetHeight - 12);
    };
    /** a transparent target over the chosen day (touch only): it is a separate element because touch-action is read when the finger lands */
    const placeGrab = () => {
      if (!touched || !chosen) {
        grab.style.display = 'none';
        return;
      }
      const k = svg.clientWidth / svg.viewBox.baseVal.width;
      const cx = (CAL.gutter + chosen.col * CAL.cell + CAL.cell / 2) * k;
      const cy = (CAL.top + chosen.row * CAL.cell + CAL.cell / 2) * k;
      grab.style.display = 'block';
      grab.style.left = cx - GRAB / 2 + 'px';
      grab.style.top = cy - GRAB / 2 + 'px';
    };
    const choose = (e: PointerEvent, ripples: boolean) => {
      chosen = cellAt(e);
      clicked = e.pointerType === 'mouse';
      show();
      if (!ripples) return;
      const { col, row } = under(e);
      ripple(col, row, 'click');
    };
    const move = (e: PointerEvent) => {
      if (e.pointerType !== 'mouse') {
        if (start && e.pointerId === pid && Math.hypot(e.clientX - start.x, e.clientY - start.y) >= TAP_SLOP)
          moved = true;
        return;
      }
      const box = svg.getBoundingClientRect(),
        vb = svg.viewBox.baseVal;
      const p = gridPoint(
        ((e.clientX - box.left) / box.width) * vb.width,
        ((e.clientY - box.top) / box.height) * vb.height,
      );
      spot.col = p.col;
      spot.row = p.row;
      spot.target = 1;
      hover = cellAt(e);
      show();
      const text = hover?.el.dataset.tip;
      const fb = fig.getBoundingClientRect();
      if (!text) {
        tip.style.opacity = '0';
        return;
      }
      openTip(text, e.clientX - fb.left + 12, e.clientY - fb.top - 48);
    };
    svg.addEventListener('pointerenter', edge);
    svg.addEventListener('pointerleave', edge);
    scroller.addEventListener('scroll', placeTip, { passive: true });
    svg.addEventListener('pointerleave', (e) => {
      // a mouse takes its clicked day with it, not one chosen by touch or keyboard (a touch also fires this on lifting)
      if (e.pointerType === 'mouse' && clicked) chosen = null;
      spot.target = 0;
      hover = null;
      show();
    });
    svg.addEventListener('pointermove', move);
    svg.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') {
        touched = false;
        choose(e, true);
        return;
      }
      // a touch only selects when it lifts without having moved; a drag is the browser scrolling the graph
      if (!e.isPrimary) return;
      touched = true;
      pid = e.pointerId;
      start = { x: e.clientX, y: e.clientY };
      moved = false;
    });
    svg.addEventListener('pointerup', (e) => {
      if (e.pointerType === 'mouse' || !start || e.pointerId !== pid) return;
      const tap = !moved;
      start = null;
      pid = -1;
      if (tap) choose(e, true);
    });
    svg.addEventListener('pointercancel', (e) => {
      if (e.pointerId !== pid) return;
      start = null;
      pid = -1;
    });

    // keyboard: the graph is one tab stop; arrows move a day or a week, Home/End jump to the first/last day
    svg.addEventListener('keydown', (e) => {
      const dx = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      const dy = e.key === 'ArrowDown' ? 1 : e.key === 'ArrowUp' ? -1 : 0;
      const edgeKey = e.key === 'Home' || e.key === 'End';
      if (!dx && !dy && !edgeKey) return;
      if (e.altKey || e.ctrlKey || e.metaKey) return;
      e.preventDefault();
      const current = chosen;
      const next = edgeKey
        ? cells[e.key === 'Home' ? 0 : cells.length - 1]
        : !current
          ? cells[cells.length - 1]
          : (byPosition.get(current.col + dx + ',' + (current.row + dy)) ?? current);
      touched = false;
      clicked = false;
      chosen = next;
      show();
      ripple(next.col, next.row, 'click');
      const box = scroller.getBoundingClientRect();
      const r = next.el.getBoundingClientRect();
      if (r.left < box.left) scroller.scrollLeft += r.left - box.left;
      else if (r.right > box.right) scroller.scrollLeft += r.right - box.right;
    });

    // scrubbing: press the chosen day and drag; the day under the finger follows, and the graph scrolls when the finger nears its edge
    let scrubbing = false;
    let finger = { x: 0, y: 0 };
    let scrollRaf = 0;
    const follow = () => {
      const box = scroller.getBoundingClientRect();
      const toward = finger.x < box.left + EDGE_ZONE ? -1 : finger.x > box.right - EDGE_ZONE ? 1 : 0;
      if (toward) {
        const depth = toward < 0 ? box.left + EDGE_ZONE - finger.x : finger.x - (box.right - EDGE_ZONE);
        scroller.scrollLeft += toward * Math.min(1, depth / EDGE_ZONE) * MAX_SCROLL;
      }
      chosen = cellAt({ clientX: finger.x, clientY: finger.y }) ?? chosen;
      clicked = false;
      show();
      scrollRaf = scrubbing ? requestAnimationFrame(follow) : 0;
    };
    const endScrub = () => {
      scrubbing = false;
      cancelAnimationFrame(scrollRaf);
      scrollRaf = 0;
    };
    grab.addEventListener('pointerdown', (e) => {
      if (!e.isPrimary) return;
      grab.setPointerCapture(e.pointerId);
      pid = e.pointerId;
      start = { x: e.clientX, y: e.clientY };
      moved = false;
      finger = { x: e.clientX, y: e.clientY };
    });
    grab.addEventListener('pointermove', (e) => {
      if (!start || e.pointerId !== pid) return;
      finger = { x: e.clientX, y: e.clientY };
      if (!moved && Math.hypot(e.clientX - start.x, e.clientY - start.y) < TAP_SLOP) return;
      moved = true;
      if (!scrubbing) {
        scrubbing = true;
        scrollRaf = requestAnimationFrame(follow);
      }
    });
    grab.addEventListener('pointerup', (e) => {
      if (e.pointerId !== pid) return;
      const tap = !moved;
      start = null;
      pid = -1;
      // commit the release point before endScrub cancels the pending follow frame
      if (!tap) {
        chosen = cellAt(e) ?? chosen;
        show();
      }
      endScrub();
      // a tap on the target lands on whichever day is under the finger, since it covers its neighbours too
      if (tap) choose(e, true);
    });
    grab.addEventListener('pointercancel', (e) => {
      if (e.pointerId !== pid) return;
      start = null;
      pid = -1;
      endScrub();
    });
    // iOS Safari can still start a scroll from a target that says touch-action: none
    grab.addEventListener('touchmove', (e) => e.preventDefault(), { passive: false });
    new ResizeObserver(() => {
      placeGrab();
      placeTip();
    }).observe(svg);
    // a charged click elsewhere sends a front across the page: the graph ripples from the cell facing it when the front arrives
    window.addEventListener(SHOCKWAVE_EVENT, (ev) => {
      const { x, y, speed } = (ev as CustomEvent<ShockwaveDetail>).detail;
      const box = svg.getBoundingClientRect();
      if (box.bottom < 0 || box.top > innerHeight) return;
      const nx = Math.min(box.right - 1, Math.max(box.left + 1, x)),
        ny = Math.min(box.bottom - 1, Math.max(box.top + 1, y));
      const vb = svg.viewBox.baseVal;
      const { col, row } = gridCell(
        ((nx - box.left) / box.width) * vb.width,
        ((ny - box.top) / box.height) * vb.height,
        columns,
      );
      setTimeout(() => ripple(col, row, 'click'), (Math.hypot(nx - x, ny - y) / speed) * 1000);
    });

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          io.disconnect();
          ripple(0, 3, 'sweep');
        },
        { threshold: 0.6 },
      );
      io.observe(svg);
    }
    // on a narrow screen the graph scrolls sideways: start at the most recent weeks
    scroller.scrollLeft = scroller.scrollWidth;
  }
</script>
