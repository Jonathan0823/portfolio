---
import ContributionCalendar from './ContributionCalendar.astro';
import { getGithubStats } from '@/lib/github-stats';
import { CODING_SINCE } from '@/lib/profile';
import { formatDuration, formatMonth, wholeYearsSince } from '@/lib/role-timeline';
import { GRID, skillIcon } from '@/lib/skill-icons';

const { publicRepos, calendar } = await getGithubStats();
const years = formatDuration(wholeYearsSince(CODING_SINCE, new Date()) * 12);
const stats = [
  { value: calendar.total.toLocaleString('en-US'), label: 'contributions in the last 12 months' },
  { value: String(publicRepos), label: 'public repos' },
  {
    value: 'Go and TypeScript',
    label: 'what I write most, then Python and Rust',
    logos: [skillIcon({ icon: 'go' }), skillIcon({ icon: 'typescript' })],
  },
  { value: years, label: `writing code every day, since ${formatMonth(CODING_SINCE)}` },
];
---

<section id="github" class="px-5 pt-[120px] md:px-24 md:pt-[176px]">
  <h2 class="sr-only">Stats</h2>
  <div data-calendar-slot class="mb-10 md:mb-14">
    <ContributionCalendar calendar={calendar} />
  </div>
  <dl class="grid grid-cols-2 gap-x-4 gap-y-6 md:grid-cols-4 md:gap-x-6 md:gap-y-8">
    {stats.map((s) => (
      <div class="flex flex-col-reverse justify-end gap-1.5 border-t border-ink pt-4">
        <dt class="text-base text-muted-strong">{s.label}</dt>
        <dd data-count-up class="text-4xl leading-none font-semibold tracking-[-0.05em] tabular-nums md:text-[56px]">
          {s.logos ? (
            <span class="flex gap-3 md:gap-4">
              <span class="sr-only">{s.value}</span>
              {s.logos.map((logo) => (
                <span data-cursor-magnet class="flex">
                  <svg
                    viewBox={`0 0 ${GRID} ${GRID}`}
                    aria-hidden="true"
                    shape-rendering="crispEdges"
                    class="size-9 md:size-14"
                  >
                    {logo.layers.map((l) => (
                      <path d={l.d} fill={l.color} />
                    ))}
                  </svg>
                </span>
              ))}
            </span>
          ) : (
            s.value
          )}
        </dd>
      </div>
    ))}
  </dl>
</section>

<script>
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const els = [...document.querySelectorAll<HTMLElement>('#github [data-count-up]')].filter((el) =>
      /^[\d,]+$/.test(el.textContent!.trim()),
    );
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          io.unobserve(e.target);
          const el = e.target as HTMLElement,
            final = el.textContent!.trim(),
            target = Number(final.replace(/,/g, ''));
          const start = performance.now();
          const tick = (now: number) => {
            const t = Math.min(1, (now - start) / 1100),
              eased = t * t * (3 - 2 * t);
            el.textContent = t < 1 ? Math.round(target * eased).toLocaleString('en-US') : final;
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }
      },
      { threshold: 0.6 },
    );
    els.forEach((el) => io.observe(el));
  }
</script>
