---
import Section from './Section.astro';
import Visual from './Visual.astro';
import TechStack from './TechStack.astro';
import { getProjects } from '@/lib/content';
import { GITHUB_REPOS_URL } from '@/lib/profile';
import { GRID, skillIcon } from '@/lib/skill-icons';
import { projectAnchor, projectLinks, projectYear, splitProjectBody } from '@/lib/projects';

const projects = await Promise.all(
  (await getProjects()).map(async (p) => ({
    p,
    links: projectLinks(p.data),
    year: projectYear(p.data.month),
    ...splitProjectBody(p.body),
  })),
);
const github = skillIcon({ icon: 'github' });
const npm = skillIcon({ icon: 'npm' });
const how = (sections: { label: string; text: string }[]) =>
  sections.filter((s) => !/result/i.test(s.label)).flatMap((s) => s.text.split(/\n\s*\n/).map((x) => x.trim()));
---

<Section id="projects" title="Projects.">
  <a slot="aside" href={GITHUB_REPOS_URL} class="text-ink">
    <span class="md:hidden">All repos ↗</span>
    <span class="hidden md:inline">All repositories ↗</span>
  </a>
  {projects.map(({ p, links, year, description, sections }) => (
    <article id={projectAnchor(p.id)} data-project={p.id} class="border-t border-ink py-6 md:py-7">
      <div data-cursor="eye" data-summary class="md:grid md:grid-cols-12 md:gap-x-6">
        <div class="md:col-span-3">
          <h3 class="text-[28px] leading-[1.1] font-semibold tracking-[-0.03em] md:text-[32px]">{p.data.name}</h3>
        </div>
        <div class="mt-2.5 flex flex-col gap-2.5 md:col-span-9 md:mt-0">
          <p class="max-w-[68ch] text-[17px] leading-[1.55] text-body text-pretty md:text-lg">
            <span class="text-ink">{description}</span>
            {p.data.result && ' ' + p.data.result}
          </p>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[15px] leading-relaxed text-muted">
            <span>{year}</span>
            <TechStack tags={p.data.tags} />
            {links.map((l) => {
              const icon = /npmjs\.com/.test(l.href) ? npm : github;
              return (
                <a
                  href={l.href}
                  class="inline-flex items-center gap-1.5 text-ink underline decoration-line underline-offset-4 hover:decoration-ink max-md:min-h-11"
                >
                  <svg
                    viewBox={`0 0 ${GRID} ${GRID}`}
                    aria-hidden="true"
                    shape-rendering="crispEdges"
                    class="size-4 shrink-0"
                  >
                    <path class="fill-ink" d={icon.base} />
                  </svg>
                  {l.text} ↗
                </a>
              );
            })}
          </div>
          <div data-toggle-slot></div>
        </div>
      </div>
      <div
        id={`${projectAnchor(p.id)}-detail`}
        data-detail
        class="grid grid-rows-[1fr] transition-[grid-template-rows] duration-[450ms] ease-[cubic-bezier(.2,.7,.2,1)] data-[collapsed]:grid-rows-[0fr] motion-reduce:transition-none"
      >
        <div class="min-h-0 overflow-hidden">
          <div class:list={['grid gap-6 pt-5 pb-2', p.data.visual.src && 'md:grid-cols-[1.1fr_1fr]']}>
            {p.data.visual.src && (
              <div class="self-start">
                <Visual visual={p.data.visual} />
              </div>
            )}
            <div class="flex flex-col gap-4">
              {how(sections).map((para) => (
                <p class="max-w-[68ch] text-[17px] leading-[1.55] text-body md:text-lg">{para}</p>
              ))}
            </div>
          </div>
        </div>
      </div>
    </article>
  ))}
  <div class="border-t border-ink"></div>

  {projects.some(({ p }) => p.data.visual.src) && (
    <div
      data-peek
      aria-hidden="true"
      class="pointer-events-none fixed top-0 left-0 z-[45] hidden aspect-[16/10] w-[min(380px,32vw)]"
    >
      <div data-peek-content class="absolute inset-0">
        {projects.map(
          ({ p }) =>
            p.data.visual.src && (
              <div data-peek-item={p.id} hidden class="absolute inset-0 bg-pixel-mist p-4">
                <img src={p.data.visual.src} alt="" loading="lazy" class="size-full object-contain" />
              </div>
            ),
        )}
      </div>
      <canvas data-peek-px class="absolute inset-0 size-full"></canvas>
      <canvas data-peek-frame class="pointer-events-none absolute inset-0 size-full"></canvas>
    </div>
  )}
</Section>

<script>
  import '@/scripts/project-peek';

  // the whole summary is the open/close control on every device; links and selected text keep their own behaviour
  document.querySelectorAll<HTMLElement>('[data-project]').forEach((project) => {
    const summary = project.querySelector<HTMLElement>('[data-summary]');
    const detail = project.querySelector<HTMLElement>('[data-detail]');
    const slot = project.querySelector<HTMLElement>('[data-toggle-slot]');
    if (!summary || !detail || !slot) return;
    // the toggle is made from script, so without JS the details just stay visible
    const button = document.createElement('button');
    button.type = 'button';
    button.className =
      'w-fit cursor-pointer text-left text-[15px] leading-relaxed text-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink';
    button.setAttribute('aria-controls', detail.id);
    slot.replaceWith(button);
    summary.classList.add('cursor-pointer');
    const set = (open: boolean) => {
      detail.toggleAttribute('data-collapsed', !open);
      detail.toggleAttribute('inert', !open);
      button.setAttribute('aria-expanded', String(open));
      button.textContent = open ? 'Details −' : 'Details +';
    };
    set(false);
    summary.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a') || getSelection()?.toString()) return;
      set(button.getAttribute('aria-expanded') !== 'true');
    });
  });
</script>
