---
interface Props {
  visual: { kind: string; label: string; src?: string | undefined };
}
const { visual } = Astro.props;
---

{visual.src && (
  <div class="aspect-[16/10] w-full border border-line-soft bg-pixel-mist p-4">
    <img src={visual.src} alt={visual.label} loading="lazy" class="size-full object-contain" />
  </div>
)}
