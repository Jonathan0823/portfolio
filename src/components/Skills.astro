---
import Section from './Section.astro';
import { getSkills } from '@/lib/content';
import { GRID, skillIcon } from '@/lib/skill-icons';

const groups = (await getSkills()).map((g) => ({
  group: g.data.group,
  items: g.data.items.map((s) => ({ ...s, ...skillIcon(s) })),
}));
---

<Section id="skills" title="Skills.">
  <div class="border-t border-ink">
    {groups.map(({ group, items }) => (
      <div data-skill-row class="grid grid-cols-12 gap-x-6 border-t border-line-soft py-5 md:py-7">
        <p class="col-span-12 pb-3 font-mono text-[13px] leading-relaxed text-muted md:col-span-3 md:pb-0">{group}</p>
        <div class="relative col-span-12 md:col-span-9">
          <ul aria-label={group} class="grid grid-cols-4 items-end gap-x-2 gap-y-5 md:flex md:flex-wrap md:gap-x-6">
            {items.map((s) => (
              <li data-cursor-magnet class="skill-tile flex flex-col items-center gap-2 md:w-[88px]">
                <svg
                  viewBox={`0 0 ${GRID} ${GRID}`}
                  aria-hidden="true"
                  shape-rendering="crispEdges"
                  data-bits={s.bits}
                  class={s.primary ? 'size-16 md:size-[76px]' : 'size-11 md:size-12'}
                >
                  <path class="fill-ink" d={s.base} />
                  <g class="skill-hot">
                    {s.layers.map((l) => (
                      <path d={l.d} fill={l.color} />
                    ))}
                  </g>
                </svg>
                <span class="text-center font-mono text-[12px] leading-tight text-ink">{s.name}</span>
              </li>
            ))}
          </ul>
          <canvas aria-hidden="true" data-skill-canvas class="pointer-events-none absolute inset-0 size-full" />
        </div>
      </div>
    ))}
  </div>
</Section>

<style is:global>
  /* the brand colour wipes in left to right, in pixel steps, on hover, when the cursor magnet locks on, or when a tapped tile is lit */
  .skill-hot {
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.32s steps(6, end);
  }
  .skill-tile[data-magnet-on] .skill-hot,
  .skill-tile[data-lit] .skill-hot {
    clip-path: inset(0 0 0 0);
  }
  /* touch keeps :hover stuck on the last tap, so only real hover devices use it */
  @media (hover: hover) {
    .skill-tile:hover .skill-hot {
      clip-path: inset(0 0 0 0);
    }
  }
  [data-skill-row].skill-wait svg {
    visibility: hidden;
  }
</style>

<script>
  import { mountSkillEntrance } from '@/scripts/skill-entrance';
  import { mountSkillColour, type SkillColour } from '@/scripts/skill-colour';
  import { FINE_POINTER_QUERY, REDUCE_QUERY } from '@/scripts/motion';

  const section = document.getElementById('skills');
  let colour: SkillColour | null = null;
  // the pointer type and motion preference pick the mode, so a change remounts it
  const syncColour = () => {
    colour?.stop();
    colour = section ? mountSkillColour(section) : null;
  };
  syncColour();
  for (const query of [FINE_POINTER_QUERY, REDUCE_QUERY])
    window.matchMedia(query).addEventListener('change', syncColour);
  mountSkillEntrance(document.querySelectorAll<HTMLElement>('[data-skill-row]'), (row) => colour?.sweep(row));
</script>
